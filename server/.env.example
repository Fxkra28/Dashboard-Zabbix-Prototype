# BFF config. Copy to server/.env and fill in ZBX_TOKEN.

# Local dev Zabbix; production -> http://<zabbix-host>/api_jsonrpc.php
ZBX_URL=http://localhost:8080/api_jsonrpc.php
ZBX_TOKEN=f0a3fc95a50d8dacb90da74daf3a2ee5326af9dcb6883b32a3b3a353c8ee0f76

PORT=4000
WEB_ORIGIN=http://localhost:5173

# Comma-separated Zabbix host group ids for network devices (§13). Empty = all hosts.
NET_GROUP_IDS=

# Optional portal login. Keep false for an open, runnable scaffold.
AUTH_ENABLED=false
JWT_SECRET=dev-insecure-secret-change-me
PORTAL_USER=Admin
PORTAL_PASS=zabbix
