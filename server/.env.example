# BFF config. Copy to server/.env and fill in the values.
# NEVER put a real credential in this file: it is committed.

# Local dev Zabbix; production -> http://<zabbix-host>/api_jsonrpc.php
ZBX_URL=http://localhost:8080/api_jsonrpc.php

# Long-lived, READ-ONLY Zabbix API token (Users -> API tokens -> Create API token).
# Set the real value in server/.env, which is gitignored.
# ZBX_TOKEN is still accepted as a deprecated alias.
ZABBIX_API_TOKEN=

# Separate WRITE-capable token, used only by acknowledge/close (§20).
# Leave blank to keep the portal strictly read-only: the ack/close endpoints
# then return 503 and the UI hides the buttons.
ZABBIX_WRITE_TOKEN=

# Ceiling on a single Zabbix JSON-RPC call. `fetch` has no default timeout, so
# without this one unresponsive Zabbix holds every page open indefinitely.
ZABBIX_TIMEOUT_MS=10000

PORT=4000
# Interface the BFF listens on. 127.0.0.1 for local dev: this dev BFF runs with
# AUTH_ENABLED=false, and on 0.0.0.0 anyone on the network can read its data.
# Docker needs 0.0.0.0 (the default when unset).
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# Honour X-Forwarded-For. Set true ONLY when nginx (or another proxy) is in
# front: trusting the header with nothing there lets a client forge its own IP
# and slip the rate limiter. Without it behind a proxy, every request looks
# like the proxy and all users share one rate-limit bucket.
TRUST_PROXY=false
# Requests per minute per IP. /api/stream and /api/health are exempt.
RATE_LIMIT_PER_MINUTE=300

# Comma-separated Zabbix host group ids for network devices (§13). Empty = all hosts.
NET_GROUP_IDS=

# Site view: how a host maps to a physical site. Tried in order,
#   1. a host tag named SITE_TAG   2. the site code in the host name (1.2.1 ... is
#   site 1; INET : SAMPANG WAN 1 is site 3)   3. inventory site_city/location
#   4. host group
# Set SITE_GROUP_PREFIX if site groups are named like "Site/SPG"; leave it
# empty to fall back to the host's first host group.
SITE_TAG=site
SITE_GROUP_PREFIX=

# Inventory scorecard (§16): which tags carry ownership/criticality, and the
# naming convention to score host names against. Empty pattern = naming not scored.
#
# HCML's real convention, read off the 2026-06/07/08 Availability Reports:
#   devices   <site>.<class>[.<seq>] NAME   e.g. "1.2.1 IDX02CORESWITCH"
#   services  <TYPE> : NAME                 e.g. "INET : SAMPANG WAN 1"
# Site = the leading digit:
#   1 Jakarta (IDX)  2 Surabaya (SBY)  3 SSB/Sampang (SAM)  4 FPSO KAS3 & BD-WHP
#   5 Pasuruan/GMS   6 Sumenep (SUP)   7 Sapudi   8 MDA   9 MBH   10 FPU
#   11 MOPU/MAC      12 Porong (POR)   13 Tanjung Wangi (TJWB)   14 TWSB
# The pattern is deliberately tolerant: HCML applies the convention
# inconsistently (trailing dots on "1.2.2.", 2- vs 3-segment depth), and the
# scorecard should measure coverage, not enforce a stricter rule than HCML uses.
OWNER_TAG=owner
CRITICALITY_TAG=criticality
HOST_NAME_PATTERN=^(\d{1,2}\.\d{1,2}(\.\d{1,2})?\.?\s|(INET|WEB|SERVER)\s:\s).+$

# Link & WAN health (§17): packet-loss thresholds, percent.
LINK_LOSS_WARN=2
LINK_LOSS_CRIT=10

# Alert-noise report (§21): an incident shorter than NOISE_SHORT_SECONDS cleared
# before anyone could act; a trigger needs NOISE_MIN_COUNT firings before
# "flapping" means anything.
NOISE_SHORT_SECONDS=300
NOISE_MIN_COUNT=5

# Severity floor for the availability report.
#
# 2 (Warning), not 3 (Average): HCML's estate fires "High ICMP ping loss" at
# severity 2 on essentially every trigger -- every row of the 2026-06/07/08
# Availability Reports. A floor of 3 makes the page open empty for them.
AVAILABILITY_MIN_SEVERITY=2

# Derived monthly SLA (setup.md, "Derived SLA and services"). HCML's Zabbix has
# no services, so the portal measures availability itself from the ICMP
# triggers every device carries. Nothing is written to Zabbix.
#   SLI_PROFILE=availability   strict: unreachable OR high loss counts as down,
#                              hours with no collected data are left out
#   SLI_PROFILE=hcml-report    reproduces HCML's published Availability Reports:
#                              only high loss counts, gaps count as up
SLO_TARGET=99
SLA_TIMEZONE=Asia/Jakarta
SLI_PROFILE=availability
SLI_REPORT_TRIGGERS=High ICMP ping loss
SLI_AVAILABILITY_TRIGGERS=Unavailable by ICMP ping,High ICMP ping loss
# Below this share of collected time a device shows "no data" instead of a figure.
SLI_MIN_COVERAGE=0.5
SLI_ZBX_PARALLEL=4

# Optional plain-language layer (plan_1.1). Leave it unconfigured and the
# portal still serves all data, only the "Explain" buttons disappear.
#
# Two backends, one switch:
#   AI_PROVIDER=anthropic          hosted Claude -- needs ANTHROPIC_API_KEY.
#   AI_PROVIDER=openai-compatible  a local model -- needs AI_BASE_URL, no key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-4-6

# Local model instead: nothing ever leaves this host. Set up with:
#   brew install ollama && brew services start ollama && ollama pull qwen3:8b
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1  # host.docker.internal:11434 from the container
# AI_MODEL=qwen3:8b
# AI_TIMEOUT_MS=120000
# AI_API_KEY=                            # only for a hosted OpenAI-compatible gateway


# The SDK defaults to a 10-minute timeout and 2 retries -- sane for a batch
# job, far too long for a request a human is waiting on behind a button.
# A local model generates more slowly and loads from disk when cold, so it
# defaults to 120000 instead. AI_MAX_RETRIES is Anthropic-only -- the SDK
# implements it; the local backend does not retry.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
# How long a local model stays loaded after its last use (Ollama keep_alive). The
# first question after an idle period otherwise waits ~10 s for qwen3:8b to load;
# keeping it loaded costs ~5 GB of memory.
AI_KEEP_ALIVE=30m
# Speak Ollama's native /api/chat instead of /v1: auto (ask {AI_BASE_URL minus
# /v1}/api/version), true or false. Only the native API takes a context size and
# honours AI_KEEP_ALIVE -- every /v1 call resets the expiry to 5 minutes.
AI_OLLAMA_NATIVE=auto
# Native only. Context window sent with EVERY request (chat, explain, warm-up,
# prefill): Ollama restarts the model and drops its prompt cache whenever a
# request asks for a different size. 8192 tokens of cache take ~0.6 GB (4096: ~0.3 GB).
AI_NUM_CTX=8192
# Native only. Sampling, stated rather than left to the server (/v1 sampled at
# 1.0 / 1.0); 0.7 / 0.8 is Qwen3's recommendation for answers without thinking.
AI_TEMPERATURE=0.7
AI_TOP_P=0.8

# Portal login + RBAC (§19). Defaults to ON: every HCML source slide is stamped
# Private and Confidential. Set false only for local dev.
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string

# Single-admin shorthand.
PORTAL_USER=Admin
PORTAL_PASS=

# Or several users: name:password:role, comma-separated. Roles: viewer | operator | admin.
# Overrides PORTAL_USER/PORTAL_PASS when set.
# PORTAL_USERS=ana:secret:viewer,budi:secret:operator,citra:secret:admin
