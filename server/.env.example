# BFF config. Copy to server/.env and fill in the values.
# NEVER put a real credential in this file: it is committed.

# HCML's Zabbix. A dev run outside Docker needs the name to lead to its LAN address (a hosts-file line).
ZBX_URL=https://zabbix.hcml.co.id/zabbix/api_jsonrpc.php

# Long-lived, READ-ONLY Zabbix API token (Users -> API tokens -> Create API token).
# Set the real value in server/.env, which is gitignored.
# ZBX_TOKEN is still accepted as a deprecated alias.
ZABBIX_API_TOKEN=

# Separate WRITE-capable token, used only by acknowledge/close (§20).
# Leave blank to keep the portal strictly read-only: the ack/close endpoints
# then return 503 and the UI hides the buttons.
# Leave it blank where Zabbix has no server process (a restored copy with zabbix-server
# stopped): Zabbix accepts a close, queues it, and nothing ever applies it.
ZABBIX_WRITE_TOKEN=

# Ceiling on a single Zabbix JSON-RPC call. `fetch` has no default timeout, so
# without this one unresponsive Zabbix holds every page open indefinitely.
# A whole number of milliseconds from 1000 to 2147483647; the server refuses to start on any other value.
ZABBIX_TIMEOUT_MS=10000

# Only while Zabbix's HTTPS certificate has expired: that one certificate, named by its SHA-256
# fingerprint, is accepted until the end of ZBX_TLS_PIN_UNTIL (YYYY-MM-DD, WIB). Leave both
# blank for the normal check. See docs/operations/tls.md.
ZBX_TLS_PIN_SHA256=
ZBX_TLS_PIN_UNTIL=

PORT=4000
# Interface the BFF listens on. 127.0.0.1 for local dev: a dev BFF with
# AUTH_ENABLED=false on 0.0.0.0 lets anyone on the network read its data.
# Docker needs 0.0.0.0 (the default when unset).
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# Honour X-Forwarded-For. Set true ONLY when nginx (or another proxy) is in
# front: trusting the header with nothing there lets a client forge its own IP
# and slip the rate limiter. Without it behind a proxy, every request looks
# like the proxy and all users share one rate-limit bucket.
TRUST_PROXY=false
# Requests per minute per IP. /api/stream and /api/health are exempt.
RATE_LIMIT_PER_MINUTE=300
# Live screens allowed at once, overall and per signed-in user.
STREAM_MAX_CLIENTS=100
STREAM_MAX_PER_USER=5

# Comma-separated Zabbix host group ids for network devices (§13). Empty = all hosts.
NET_GROUP_IDS=

# Site view: how a host maps to a physical site. Tried in order,
#   1. a host tag named SITE_TAG   2. the site code in the host name (1.2.1 ... is
#   site 1; INET : SAMPANG WAN 1 is site 3)   3. inventory site_city/location
#   4. host group
# Set SITE_GROUP_PREFIX if site groups are named like "Site/SPG"; leave it
# empty to fall back to the host's first host group.
SITE_TAG=site
SITE_GROUP_PREFIX=

# Inventory scorecard (§16): which tags carry ownership/criticality, and the
# naming convention to score host names against. Empty pattern = naming not scored.
#
# HCML's real convention, read off the 2026-06/07/08 Availability Reports:
#   devices   <site>.<class>[.<seq>] NAME   e.g. "1.2.1 IDX02CORESWITCH"
#   services  <TYPE> : NAME                 e.g. "INET : SAMPANG WAN 1"
# Site = the leading digit:
#   1 Jakarta (IDX)  2 Surabaya (SBY)  3 SSB/Sampang (SAM)  4 FPSO KAS3 & BD-WHP
#   5 Pasuruan/GMS   6 Sumenep (SUP)   7 Sapudi   8 MDA   9 MBH   10 FPU
#   11 MOPU/MAC      12 Porong (POR)   13 Tanjung Wangi (TJWB)   14 TWSB
# The pattern is deliberately tolerant: HCML applies the convention
# inconsistently (trailing dots on "1.2.2.", 2- vs 3-segment depth), and the
# scorecard should measure coverage, not enforce a stricter rule than HCML uses.
OWNER_TAG=owner
CRITICALITY_TAG=criticality
HOST_NAME_PATTERN=^(\d{1,2}\.\d{1,2}(\.\d{1,2})?\.?\s|(INET|WEB|SERVER)\s:\s).+$

# Link & WAN health (§17): packet-loss thresholds, percent.
LINK_LOSS_WARN=2
LINK_LOSS_CRIT=10

# Internet traffic meters on the Dashboard (wall, operator and admin): the Zabbix dashboard whose gauge widgets
# name each link, the interface item behind it, its capacity and its colour zones. HCML's is "Global view".
INTERNET_METERS_DASHBOARD=Global view

# Alert-noise report (§21): an incident shorter than NOISE_SHORT_SECONDS cleared
# before anyone could act; a trigger needs NOISE_MIN_COUNT firings before
# "flapping" means anything.
NOISE_SHORT_SECONDS=300
NOISE_MIN_COUNT=5

# Severity floor for the availability report.
#
# 2 (Warning), not 3 (Average): HCML's estate fires "High ICMP ping loss" at
# severity 2 on essentially every trigger -- every row of the 2026-06/07/08
# Availability Reports. A floor of 3 makes the page open empty for them.
AVAILABILITY_MIN_SEVERITY=2

# Derived monthly SLA (setup.md, "Derived SLA and services"). HCML's Zabbix has
# no services, so the portal measures availability itself from the ICMP
# triggers every device carries. Nothing is written to Zabbix.
#   SLI_PROFILE=availability   strict: unreachable OR high loss counts as down,
#                              hours with no collected data are left out
#   SLI_PROFILE=hcml-report    reproduces HCML's published Availability Reports:
#                              only high loss counts, gaps count as up
# A percentage from 0 to 100; anything else stops the server at start.
SLO_TARGET=99
SLA_TIMEZONE=Asia/Jakarta
SLI_PROFILE=availability
SLI_REPORT_TRIGGERS=High ICMP ping loss
SLI_AVAILABILITY_TRIGGERS=Unavailable by ICMP ping,High ICMP ping loss
# Below this share of collected time a device shows "no data" instead of a figure. A number from 0 to 1; anything else stops the server at start.
SLI_MIN_COVERAGE=0.5
SLI_ZBX_PARALLEL=4
# Spans the SLA figures treat as hours with no data, for a time Zabbix was cut off from the
# network: start/end in ISO time with its zone, comma-separated. Nothing in Zabbix changes.
#   SLA_NO_DATA_WINDOWS=2026-10-26T16:10+07:00/2026-10-26T21:03+07:00
SLA_NO_DATA_WINDOWS=

# Optional plain-language layer (plan_1.1). Leave it unconfigured and the
# portal still serves all data, only the "Explain" buttons disappear.
#
# Two backends, one switch:
#   AI_PROVIDER=anthropic          hosted Claude -- needs ANTHROPIC_API_KEY.
#   AI_PROVIDER=openai-compatible  a local model -- needs AI_BASE_URL, no key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-4-6

# Local model instead: nothing ever leaves this host. Set up with:
#   brew install ollama && brew services start ollama && ollama pull qwen3:8b
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1  # host.docker.internal:11434 from the container
# AI_MODEL=qwen3:8b
# AI_API_KEY=                            # only for a hosted OpenAI-compatible gateway

# The SDK defaults to a 10-minute timeout and 2 retries: sane for a batch job, far too long for a
# request a human is waiting on behind a button. AI_TIMEOUT_MS is left out on purpose. Empty, the
# BFF uses 30000 for the hosted API and 120000 for a local model, which generates more slowly and
# loads from disk when cold. Set it only to override both, and only once: the LAST assignment in
# this file wins, which is how a leftover 30000 once cut a local model off at 30 seconds (IN-19).
# AI_TIMEOUT_MS=
# AI_MAX_RETRIES is Anthropic-only: the SDK implements it, the local backend does not retry.
AI_MAX_RETRIES=1
# How long a local model stays loaded after its last use (Ollama keep_alive). The
# first question after an idle period otherwise waits ~10 s for qwen3:8b to load;
# keeping it loaded costs ~5 GB of memory.
AI_KEEP_ALIVE=30m
# Speak Ollama's native /api/chat instead of /v1: auto (ask {AI_BASE_URL minus
# /v1}/api/version), true or false. Only the native API takes a context size and
# honours AI_KEEP_ALIVE -- every /v1 call resets the expiry to 5 minutes.
AI_OLLAMA_NATIVE=auto
# Native only. Context window sent with EVERY request (chat, explain, warm-up,
# prefill): Ollama restarts the model and drops its prompt cache whenever a
# request asks for a different size. 8192 tokens of cache take ~0.6 GB (4096: ~0.3 GB).
AI_NUM_CTX=8192
# Native only. Sampling, stated rather than left to the server (/v1 sampled at
# 1.0 / 1.0); 0.7 / 0.8 is Qwen3's recommendation for answers without thinking.
AI_TEMPERATURE=0.7
AI_TOP_P=0.8
# Caps on Explain and the Assistant, per signed-in user: a minute, calls in flight at once, and
# tokens a day (0 turns a budget off; only the hosted API is counted).
AI_CHAT_PER_MINUTE=10
AI_EXPLAIN_PER_MINUTE=10
AI_MAX_CONCURRENT=4
AI_DAILY_TOKENS_PER_USER=500000
AI_DAILY_TOKENS_TOTAL=2000000

# Emailing the SLA report (optional, administrators only). Leave all of these blank and the portal sends no email
# and hides the button. Use a mailbox made for the portal, not a personal one, and put the real values in .env.
# MAIL_PROVIDER=gmail   # gmail, yahoo, zoho, icloud, or smtp for a server of your own (then set MAIL_HOST)
# MAIL_HOST=            # only for smtp, or to name another server for a provider (smtp.zoho.eu for Zoho in Europe)
# MAIL_PORT=            # blank takes the provider's: 465 (TLS) or 587 (STARTTLS)
# MAIL_SECURITY=        # tls, starttls or none; blank follows the port. none is refused alongside a password
# MAIL_USER=            # the address you sign in with
# MAIL_PASS=            # an app password for Gmail, Yahoo, iCloud and Zoho, never the usual password
# MAIL_FROM=            # blank = MAIL_USER. Gmail sends as the signed-in account whatever this says
# MAIL_FROM_NAME=       # the name shown beside the sender's address, up to 64 characters; blank = HCML Monitoring Portal
# MAIL_TO=              # the list the portal starts with: up to 10 addresses, separated by commas. The people who get the report are then chosen in the portal, and this may stay blank
# MAIL_ALLOWED_DOMAINS= # the only domains a report may go to, such as hcml.co.id; blank = any address, which an administrator's account can then choose
# MAIL_SCHEDULE=        # off keeps the monthly send from running on this machine (use it on a second copy of the portal); blank = on
# PORTAL_STATE_DIR=     # a folder that outlives the container, for the saved recipients, the schedule and a record of sends; the Docker setup sets it to /data

# Portal login + RBAC (§19). Defaults to ON: every HCML source slide is stamped
# Private and Confidential. Set false only for local dev.
AUTH_ENABLED=true
# With auth on, the BFF refuses to start without a real secret. Generate one:
#   openssl rand -hex 32
# Give each copy (hcml-portal and hcml-portal-ollama) its own: a leaked secret then opens one
# portal, not both. Tokens already carry each copy's cookie name, so a token from one is refused
# by the other either way.
JWT_SECRET=
# How long one sign-in lasts, in hours (2 to 24). An open portal renews its own before then, so
# this bounds how long a forgotten session works, not how long a wall screen stays in. A copy of a token that
# is kept renewing after the owner only closed the tab (no sign-out) lives until the user is removed, SESSION_EPOCH is raised or
# JWT_SECRET changes. Signing out ends the whole chain and the live streams.
SESSION_HOURS=12
# Bump this number (1, 2, 3 ...) and restart to end every session at once, without a new secret.
SESSION_EPOCH=1
# The session cookie's name. Cookies ignore ports, so each copy needs its own.
SESSION_COOKIE=hcml_session

# Single-admin shorthand. With auth on, an empty password or "admin" stops the
# BFF from starting.
PORTAL_USER=admin
PORTAL_PASS=

# Or several users: name:password:role, comma-separated. Roles: viewer | wall | operator | admin.
# Overrides PORTAL_USER/PORTAL_PASS when set.
# PORTAL_USERS=ana:<password-for-ana>:viewer,budi:<password-for-budi>:operator,citra:<password-for-citra>:admin
# A password on the short list everyone tries, or one still written as a <placeholder>, starts the server with a warning.
