# Root env — used by docker-compose. Copy to .env and fill in.
# NEVER put a real credential in this file — it is committed.

# Zabbix API (production points at the real host)
ZBX_URL=http://zabbix-host/api_jsonrpc.php

# Long-lived, READ-ONLY Zabbix API token. Real value goes in .env (gitignored).
# ZBX_TOKEN is still accepted as a deprecated alias.
ZABBIX_API_TOKEN=

# Separate WRITE-capable token, used only by acknowledge/close (§20).
# Blank = portal stays strictly read-only.
ZABBIX_WRITE_TOKEN=

# Origin allowed by the BFF for CORS (in Docker the browser hits the web origin, same-origin /bff)
WEB_ORIGIN=http://localhost:8081

# Comma-separated Zabbix host group ids that hold network devices (routers/switches/…). Empty = all.
NET_GROUP_IDS=

# Site view: host → site resolution (tag, then inventory site_city/location, then host group).
SITE_TAG=site
SITE_GROUP_PREFIX=

# Inventory scorecard + link thresholds.
# HCML naming convention is SITE-DEVTYPE-SEQ — site codes:
#   SPG Sampang · GMS GMS Pasuruan · MPR MOPU Prameswari · SMN Sumenep
#   TRJ Trunojoyo · ORF ORF Porong · TWG Tanjung Wangi
OWNER_TAG=owner
CRITICALITY_TAG=criticality
HOST_NAME_PATTERN=^(SPG|GMS|MPR|SMN|TRJ|ORF|TWG)-[A-Z]{2,6}-[0-9]{2,3}$
LINK_LOSS_WARN=2
LINK_LOSS_CRIT=10

# Alert-noise report (§21): an incident shorter than NOISE_SHORT_SECONDS cleared
# before anyone could act; a trigger needs NOISE_MIN_COUNT firings before
# "flapping" means anything.
NOISE_SHORT_SECONDS=300
NOISE_MIN_COUNT=5

# Plain-language layer (optional, plan_1.1). Blank key = "Explain" buttons hidden.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-4-6

# Portal login + RBAC. Defaults to ON for any real deployment.
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
PORTAL_USER=Admin
PORTAL_PASS=
# name:password:role (viewer | operator | admin), comma-separated.
# PORTAL_USERS=ana:secret:viewer,budi:secret:operator,citra:secret:admin
