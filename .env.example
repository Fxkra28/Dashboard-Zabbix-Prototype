# Root env, used by docker-compose. Copy to .env and fill in.
# NEVER put a real credential in this file: it is committed.
# A value shown here is what docker-compose.yml uses when the key is left out, so copying the file
# changes nothing until you edit it. The few that differ are placeholders or examples, and
# compose-env.test.ts lists each with its reason.

# Zabbix API (production points at the real host)
ZBX_URL=http://zabbix-host/api_jsonrpc.php

# Long-lived, READ-ONLY Zabbix API token. Real value goes in .env (gitignored).
# ZBX_TOKEN is still accepted as a deprecated alias.
ZABBIX_API_TOKEN=

# Separate WRITE-capable token, used only by acknowledge/close (§20).
# Blank = portal stays strictly read-only.
# Leave it blank where Zabbix has no server process (a restored copy with zabbix-server
# stopped): Zabbix accepts a close, queues it, and nothing ever applies it.
ZABBIX_WRITE_TOKEN=

# Ceiling on a single Zabbix JSON-RPC call. `fetch` has no default timeout, so
# without this one unresponsive Zabbix holds every page open indefinitely.
ZABBIX_TIMEOUT_MS=10000

# Origin allowed by the BFF for CORS (in Docker the browser hits the web origin, same-origin /bff)
WEB_ORIGIN=http://localhost:8081
# The port the web container publishes on 127.0.0.1. Keep WEB_ORIGIN in step with it.
# WEB_PORT=8081

# Honour X-Forwarded-For. In Docker nginx is always in front, so this is true here, as in
# docker-compose.yml: with false, every request looks like the proxy, all users share one
# rate-limit bucket and the sign-in lockout cannot tell people apart. Set false ONLY where
# nothing is in front (server/.env.example does): trusting the header then lets a client
# forge its own IP and slip the rate limiter.
TRUST_PROXY=true
# Requests per minute per IP. /api/stream and /api/health are exempt.
RATE_LIMIT_PER_MINUTE=300
# Live screens allowed at once, overall and per signed-in user.
STREAM_MAX_CLIENTS=100
STREAM_MAX_PER_USER=5

# Comma-separated Zabbix host group ids that hold network devices (routers/switches/…). Empty = all.
NET_GROUP_IDS=

# Site view: host → site resolution (tag, then inventory site_city/location, then host group).
SITE_TAG=site
SITE_GROUP_PREFIX=

# Inventory scorecard + link thresholds.
# HCML's real naming convention (from the 2026-06/07/08 Availability Reports):
#   devices   <site>.<class>[.<seq>] NAME   e.g. "1.2.1 IDX02CORESWITCH"
#   services  <TYPE> : NAME                 e.g. "INET : SAMPANG WAN 1"
# Sites are the leading digit, 1–14: Jakarta, Surabaya, SSB/Sampang, FPSO KAS3
# & BD-WHP, Pasuruan/GMS, Sumenep, Sapudi, MDA, MBH, FPU, MOPU/MAC, Porong,
# Tanjung Wangi, TWSB. See server/.env.example for the full map.
OWNER_TAG=owner
CRITICALITY_TAG=criticality
HOST_NAME_PATTERN=^(\d{1,2}\.\d{1,2}(\.\d{1,2})?\.?\s|(INET|WEB|SERVER)\s:\s).+$
LINK_LOSS_WARN=2
LINK_LOSS_CRIT=10

# Internet traffic meters on the Dashboard (operator and admin): the Zabbix dashboard whose gauge widgets
# name each link, the interface item behind it, its capacity and its colour zones. HCML's is "Global view".
INTERNET_METERS_DASHBOARD=Global view

# Alert-noise report (§21): an incident shorter than NOISE_SHORT_SECONDS cleared
# before anyone could act; a trigger needs NOISE_MIN_COUNT firings before
# "flapping" means anything.
NOISE_SHORT_SECONDS=300
NOISE_MIN_COUNT=5

# Severity floor for the availability report.
#
# 2 (Warning), not 3 (Average): HCML's estate fires "High ICMP ping loss" at
# severity 2 on essentially every trigger -- every row of the 2026-06/07/08
# Availability Reports. A floor of 3 makes the page open empty for them.
AVAILABILITY_MIN_SEVERITY=2

# Derived monthly SLA (SLA and Services pages, the report downloads). HCML's Zabbix has no
# services, so the portal measures availability itself from the ICMP triggers every device
# carries; nothing is written to Zabbix. Each value is the BFF's own default.
#   SLI_PROFILE=availability   strict: unreachable OR high loss counts as down,
#                              hours with no collected data are left out
#   SLI_PROFILE=hcml-report    reproduces HCML's published Availability Reports:
#                              only high loss counts, gaps count as up
SLO_TARGET=99
SLA_TIMEZONE=Asia/Jakarta
SLI_PROFILE=availability
SLI_REPORT_TRIGGERS=High ICMP ping loss
SLI_AVAILABILITY_TRIGGERS=Unavailable by ICMP ping,High ICMP ping loss
# Below this share of collected time a device shows "no data" instead of a figure.
SLI_MIN_COVERAGE=0.5
# Zabbix requests the SLA build runs at once.
SLI_ZBX_PARALLEL=4

# Plain-language layer (optional, plan_1.1). Two backends, one switch:
#   AI_PROVIDER=anthropic          hosted Claude -- needs ANTHROPIC_API_KEY.
#   AI_PROVIDER=openai-compatible  a local model -- needs AI_BASE_URL, no key.
# Unconfigured either way = "Explain" buttons hidden, everything else works.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-4-6

# Local model instead: nothing ever leaves this host. Set up with:
#   brew install ollama && brew services start ollama && ollama pull qwen3:8b
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1  # host.docker.internal:11434 from the container
# AI_MODEL=qwen3:8b
# AI_API_KEY=                            # only for a hosted OpenAI-compatible gateway

# The SDK defaults to a 10-minute timeout and 2 retries: sane for a batch job, far too long for a
# request a human is waiting on behind a button. AI_TIMEOUT_MS is left out on purpose. Empty, the
# BFF uses 30000 for the hosted API and 120000 for a local model, which generates more slowly and
# loads from disk when cold. Set it only to override both, and only once: the LAST assignment in
# this file wins, which is how a leftover 30000 once cut a local model off at 30 seconds (IN-19).
# AI_TIMEOUT_MS=
# AI_MAX_RETRIES is Anthropic-only: the SDK implements it, the local backend does not retry.
AI_MAX_RETRIES=1
# Local model only (a hosted API ignores these five). How long the model stays loaded after its
# last use; speak Ollama's native /api/chat (auto, true or false); the context window sent with
# every request; and the sampling. See server/.env.example for what each one does.
AI_KEEP_ALIVE=30m
AI_OLLAMA_NATIVE=auto
AI_NUM_CTX=8192
AI_TEMPERATURE=0.7
AI_TOP_P=0.8
# Caps on Explain and the Assistant, per signed-in user: a minute, calls in flight at once, and
# tokens a day (0 turns a budget off; only the hosted API is counted).
AI_CHAT_PER_MINUTE=10
AI_EXPLAIN_PER_MINUTE=10
AI_MAX_CONCURRENT=4
AI_DAILY_TOKENS_PER_USER=500000
AI_DAILY_TOKENS_TOTAL=2000000

# Portal login + RBAC. Defaults to ON for any real deployment.
AUTH_ENABLED=true
# With auth on, the BFF refuses to start without a real secret. Generate one:
#   openssl rand -hex 32
# Give each copy (hcml-portal and hcml-portal-ollama) its own: a leaked secret then opens one
# portal, not both. Tokens already carry each copy's cookie name, so a token from one is refused
# by the other either way.
JWT_SECRET=
# How long one sign-in lasts, in hours (2 to 24). An open portal renews its own before then, so
# this bounds how long a copied or forgotten session works, not how long a wall screen stays in.
SESSION_HOURS=12
# Bump this number (1, 2, 3 ...) and restart to end every session at once, without a new secret.
SESSION_EPOCH=1
# The session cookie's name. Cookies ignore ports, so each copy needs its own.
SESSION_COOKIE=hcml_session
PORTAL_USER=admin
# Required with auth on unless PORTAL_USERS is set: an empty password or "admin"
# stops the BFF from starting.
PORTAL_PASS=
# name:password:role (viewer | operator | admin), comma-separated.
# PORTAL_USERS=ana:secret:viewer,budi:secret:operator,citra:secret:admin
