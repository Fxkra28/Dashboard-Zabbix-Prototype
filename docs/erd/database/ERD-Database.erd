    "foregroundMemos": [
        {
            "memoId": "a859d8a0-a5cc-439e-a169-9cdd4ec28e64",
            "memo": "Relations MySQL does not enforce.\n\nZabbix joins these in application code, so there is no foreign key to model. They are drawn dashed in ERD-Database.mmd and listed here so the two agree.\n\ntriggers -> events : objectid when object=0, no FK\ntriggers -> problem : objectid when object=0, no FK\nacknowledges -> task_close_problem : acknowledgeid, no FK\nacknowledges -> task_acknowledge : acknowledgeid, no FK\nitems -> history : itemid, value_type 0, no FK\nitems -> history_str : itemid, value_type 1, no FK\nitems -> history_log : itemid, value_type 2, no FK\nitems -> history_uint : itemid, value_type 3, no FK\nitems -> history_text : itemid, value_type 4, no FK\nitems -> trends : itemid, value_type 0, no FK\nitems -> trends_uint : itemid, value_type 3, no FK\nhosts -> sysmaps_elements : elementid when elementtype=0, no FK\nservice_tag -> sla_service_tag : matched on tag and value, no key\nproblem_tag -> service_problem_tag : matched on tag and value by the server",
            "rectangleViewModel": {
                "positionX": 60,
                "positionY": -460,
                "width": 700,
                "height": 400
            },
            "backgroundColor": {
                "red": 254,
                "green": 243,
                "blue": 199
            },
            "foregroundColor": {
                "red": 15,
                "green": 23,
                "blue": 42
            },
            "verticalAlign": "center",
            "horizontalAlign": "center",
            "fontSize": 9,
            "createdAt": "2026-09-23T00:41:02.757Z"
        },
        {
            "memoId": "0d98f4f5-fbb4-4699-babc-f9c0674db8e4",
            "memo": "1. Hosts & Inventory",
            "rectangleViewModel": {
                "positionX": -260,
                "positionY": 60,
                "width": 220,
                "height": 70
            },
            "backgroundColor": {
                "red": 226,
