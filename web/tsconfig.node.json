{
  "compilerOptions": {
    "composite": true,
    // Out of the way. Emitting beside the source put a vite.config.js next to
    // vite.config.ts, and Vite loads the .js first, so a stale one silently
    // overrode the real config.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
